{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTAS alias index",
  "description": "ctas/data/alias-index.json: every provider-scoped public designation with the CTAS record it is bound to.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ctas.public-alias-index@1.0.0"
    },
    "catalog_content_checksum_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "alias_count": {
      "type": "integer",
      "minimum": 0
    },
    "columns": {
      "const": [
        "event_id",
        "source_key",
        "designation",
        "ambiguous"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ],
        "minItems": 4,
        "maxItems": 4
      }
    }
  },
  "required": [
    "schema",
    "catalog_content_checksum_sha256",
    "candidate_count",
    "alias_count",
    "columns",
    "rows"
  ],
  "additionalProperties": false
}
