{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTAS observatory profiles",
  "description": "ctas/data/observatories.json: fixed public site coordinates for the browser-local observing tools (certificate-bound input, not generated by the exporter).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ctas.public-observatory-profiles@1.0.0"
    },
    "claim_boundary": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "latitude_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "elevation_m": {
            "type": "number",
            "minimum": -500,
            "maximum": 9000
          },
          "timezone": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "source_url": {
            "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
          }
        },
        "required": [
          "id",
          "name",
          "latitude_deg",
          "longitude_deg",
          "elevation_m",
          "timezone"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "claim_boundary",
    "sites"
  ],
  "additionalProperties": false
}
