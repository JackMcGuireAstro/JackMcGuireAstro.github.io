# %ECSV 1.0
# ---
# datatype:
# - name: published_at
#   datatype: string
#   description: Release clock of the catalog change. ISO 8601 UTC text; empty when the public record does not retain it.
#   meta: !!omap
#   - {ucd: time.epoch;meta.main}
# - name: change_kind
#   datatype: string
#   description: candidate-intake or record-update.
#   meta: !!omap
#   - {ucd: meta.code}
# - name: previous_candidate_count
#   datatype: int64
#   description: Public candidates in the previous release.
#   meta: !!omap
#   - {ucd: meta.number}
# - name: candidate_count
#   datatype: int64
#   description: Public candidates in this release.
#   meta: !!omap
#   - {ucd: meta.number}
# - name: added_count
#   datatype: int64
#   description: Records added since the previous release.
#   meta: !!omap
#   - {ucd: meta.number}
# - name: removed_count
#   datatype: int64
#   description: Records removed since the previous release.
#   meta: !!omap
#   - {ucd: meta.number}
# - name: changed_count
#   datatype: int64
#   description: Existing records whose public content changed.
#   meta: !!omap
#   - {ucd: meta.number}
# - name: summary
#   datatype: string
#   description: Plain-words summary of the change.
#   meta: !!omap
#   - {ucd: meta.note}
# - name: added_source_summary
#   datatype: string
#   description: JSON object counting added records by discovery survey.
#   meta: !!omap
#   - {ucd: meta.number}
# - name: sample_added
#   datatype: string
#   description: JSON list of up to twelve added designations.
#   meta: !!omap
#   - {ucd: meta.id}
# - name: sample_removed
#   datatype: string
#   description: JSON list of up to twelve removed designations.
#   meta: !!omap
#   - {ucd: meta.id}
# - name: catalog_content_checksum_sha256
#   datatype: string
#   description: Semantic catalog checksum of this release.
#   meta: !!omap
#   - {ucd: meta.id;meta.cryptographic}
# - name: previous_catalog_content_checksum_sha256
#   datatype: string
#   description: Semantic catalog checksum of the previous release.
#   meta: !!omap
#   - {ucd: meta.id;meta.cryptographic}
# - name: base_commit
#   datatype: string
#   description: Git commit of the published release the diff was taken against.
#   meta: !!omap
#   - {ucd: meta.id}
# - name: history_basis
#   datatype: string
#   description: How the entry was derived.
#   meta: !!omap
#   - {ucd: meta.code}
# meta: !!omap
# - {name: ctas_release_history}
# - {description: 'Checksum-addressed public catalog changes, newest first. Counts describe public CTAS catalog changes, not independent
#     discoveries or scientific validation.'}
# - {catalog_content_checksum_sha256: 5534832310de4d04252c3962c3ad5c2c662118f064038d469b9bdd39975f4d73}
# - {claim_boundary: 'Formats and metadata follow the IVOA documents named in each file; the content is the same retained public evidence
#     as the JSON release, not an independent measurement.'}
# schema: astropy-2.0
published_at change_kind previous_candidate_count candidate_count added_count removed_count changed_count summary added_source_summary sample_added sample_removed catalog_content_checksum_sha256 previous_catalog_content_checksum_sha256 base_commit history_basis
