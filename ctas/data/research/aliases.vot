  <TABLE ID="ctas_aliases" name="ctas_aliases">
   <DESCRIPTION>
    Provider-scoped public designations bound to CTAS event
    identifiers. An alias is a retained assertion, not independent
    identity validation.
   </DESCRIPTION>
   <FIELD ID="event_id" arraysize="*" datatype="unicodeChar" name="event_id" ucd="meta.id;meta.main">
    <DESCRIPTION>
     CTAS public event identifier the alias is bound to.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="source_key" arraysize="*" datatype="unicodeChar" name="source_key" ucd="meta.id">
    <DESCRIPTION>
     Source-universe key of the provider that asserted the
     designation.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="designation" arraysize="*" datatype="unicodeChar" name="designation" ucd="meta.id">
    <DESCRIPTION>
     Provider-scoped public designation as asserted.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="ambiguous" datatype="boolean" name="ambiguous" ucd="meta.code">
    <DESCRIPTION>
     True when the unscoped designation is bound to more than one CTAS
     record.
    </DESCRIPTION>
   </FIELD>
