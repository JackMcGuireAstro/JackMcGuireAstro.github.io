<VOTABLE version="1.5" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/VOTable-1.5.xsd">
 <DESCRIPTION>
  Formats and metadata follow the IVOA documents named in each file;
  the content is the same retained public evidence as the JSON
  release, not an independent measurement.
 </DESCRIPTION>
 <RESOURCE type="results">
  <COOSYS ID="ICRS" system="ICRS"/>
  <TABLE ID="ctas_release_history" name="ctas_release_history">
   <DESCRIPTION>
    Checksum-addressed public catalog changes, newest first. Counts
    describe public CTAS catalog changes, not independent discoveries
    or scientific validation.
   </DESCRIPTION>
   <FIELD ID="published_at" arraysize="*" datatype="unicodeChar" name="published_at" ucd="time.epoch;meta.main">
    <DESCRIPTION>
     Release clock of the catalog change. ISO 8601 UTC text; empty
     when the public record does not retain it.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="change_kind" arraysize="*" datatype="unicodeChar" name="change_kind" ucd="meta.code">
    <DESCRIPTION>
     candidate-intake or record-update.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="previous_candidate_count" datatype="long" name="previous_candidate_count" ucd="meta.number">
    <DESCRIPTION>
     Public candidates in the previous release.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="candidate_count" datatype="long" name="candidate_count" ucd="meta.number">
    <DESCRIPTION>
     Public candidates in this release.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="added_count" datatype="long" name="added_count" ucd="meta.number">
    <DESCRIPTION>
     Records added since the previous release.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="removed_count" datatype="long" name="removed_count" ucd="meta.number">
    <DESCRIPTION>
     Records removed since the previous release.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="changed_count" datatype="long" name="changed_count" ucd="meta.number">
    <DESCRIPTION>
     Existing records whose public content changed.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="summary" arraysize="*" datatype="unicodeChar" name="summary" ucd="meta.note">
    <DESCRIPTION>
     Plain-words summary of the change.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="added_source_summary" arraysize="*" datatype="unicodeChar" name="added_source_summary" ucd="meta.number">
    <DESCRIPTION>
     JSON object counting added records by discovery survey.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="sample_added" arraysize="*" datatype="unicodeChar" name="sample_added" ucd="meta.id">
    <DESCRIPTION>
     JSON list of up to twelve added designations.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="sample_removed" arraysize="*" datatype="unicodeChar" name="sample_removed" ucd="meta.id">
    <DESCRIPTION>
     JSON list of up to twelve removed designations.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="catalog_content_checksum_sha256" arraysize="*" datatype="unicodeChar" name="catalog_content_checksum_sha256" ucd="meta.id;meta.cryptographic">
    <DESCRIPTION>
     Semantic catalog checksum of this release.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="previous_catalog_content_checksum_sha256" arraysize="*" datatype="unicodeChar" name="previous_catalog_content_checksum_sha256" ucd="meta.id;meta.cryptographic">
    <DESCRIPTION>
     Semantic catalog checksum of the previous release.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="base_commit" arraysize="*" datatype="unicodeChar" name="base_commit" ucd="meta.id">
    <DESCRIPTION>
     Git commit of the published release the diff was taken against.
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="history_basis" arraysize="*" datatype="unicodeChar" name="history_basis" ucd="meta.code">
    <DESCRIPTION>
     How the entry was derived.
    </DESCRIPTION>
   </FIELD>
