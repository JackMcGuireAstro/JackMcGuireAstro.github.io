{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackmcguireastro.github.io/worldsindex/schemas/observing-windows.schema.json",
  "title": "worldsindex.observing-windows.v1",
  "description": "worldsindex/data/observing-windows.json (Framework v2 Track 4): the precomputed 30-night list of full transit windows at WIRO and Red Buttes, regenerated every build from transit-ephemerides.json.gz with worldsindex/assets/observe.js.",
  "type": "object",
  "required": ["schemaName", "schemaVersion", "windowStart", "nights", "sites", "selection", "windowRule", "parameters", "claimBoundary", "columns", "rows"],
  "properties": {
    "schemaName": {"const": "worldsindex.observing-windows.v1"},
    "schemaVersion": {"const": "1.0.0"},
    "generatedAt": {"type": ["string", "null"]},
    "windowStart": {"$ref": "common.schema.json#/$defs/isoDateTime"},
    "nights": {"const": 30},
    "sites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "latitudeDeg", "longitudeDeg", "timezone"],
        "properties": {
          "id": {"type": "string"}, "name": {"type": "string"},
          "latitudeDeg": {"type": "number", "minimum": -90, "maximum": 90}, "longitudeDeg": {"type": "number", "minimum": -180, "maximum": 180},
          "elevationM": {"type": ["number", "null"]}, "timezone": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "selection": {"type": "string"},
    "windowRule": {"type": "string"},
    "parameters": {"type": "object"},
    "ephemerisSource": {"type": "string"},
    "eligiblePlanets": {"type": "integer", "minimum": 0},
    "perSite": {"type": "object", "additionalProperties": {"type": "object"}},
    "claimBoundary": {"type": "string"},
    "columns": {"const": ["site", "night", "objectId", "name", "host", "windowStartUtc", "ingressUtc", "midUtc", "egressUtc", "windowEndUtc", "sigmaMinutes", "depthPpt", "altMidDeg", "moonSepDeg", "moonIllumination"]},
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string"}, {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, {"type": "string"}, {"type": "string"}, {"type": ["string", "null"]},
          {"$ref": "common.schema.json#/$defs/isoDateTime"}, {"$ref": "common.schema.json#/$defs/isoDateTime"}, {"$ref": "common.schema.json#/$defs/isoDateTime"},
          {"$ref": "common.schema.json#/$defs/isoDateTime"}, {"$ref": "common.schema.json#/$defs/isoDateTime"},
          {"type": ["number", "null"], "minimum": 0}, {"type": ["number", "null"]}, {"type": "number", "minimum": 0, "maximum": 90},
          {"type": "number", "minimum": 0, "maximum": 180}, {"type": "number", "minimum": 0, "maximum": 1}
        ],
        "items": false,
        "minItems": 15
      }
    }
  },
  "additionalProperties": false
}
