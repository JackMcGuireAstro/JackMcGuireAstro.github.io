<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.jackmcguireastro.ctas-mirror</string>

    <!-- Update the dedicated public publisher checkout, then mirror one
         transactionally frozen CTAS database snapshot to GitHub Pages. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_HOME/Library/Application Support/CTASPublisher/site/scripts/ctas_launchd_runner.sh</string>
    </array>

    <!-- Deterministic two-minute check while the Mac is awake and the user is
         logged in. The publisher avoids commits for unchanged state. -->
    <key>StartInterval</key>
    <integer>120</integer>

    <!-- Publish once when the agent is loaded, so the site is current
         immediately rather than waiting for the next database write. -->
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_HOME/Library/Application Support/CTASPublisher/site</string>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_HOME/Library/Logs/ctas-mirror/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_HOME/Library/Logs/ctas-mirror/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>GIT_TERMINAL_PROMPT</key>
        <string>0</string>
        <!-- launchd jobs get no ssh-agent, so tell ssh to use the key on disk
             directly and never try to ask a human anything. The key's
             passphrase, if it has one, comes from the login keychain. -->
        <key>GIT_SSH_COMMAND</key>
        <string>ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -i REPLACE_WITH_HOME/.ssh/id_ed25519</string>
        <key>HOME</key>
        <string>REPLACE_WITH_HOME</string>
        <!-- Minimum seconds between published commits. Lower it for a faster
             mirror and more commits; raise it for fewer. -->
        <key>CTAS_MIN_INTERVAL</key>
        <string>0</string>
        <key>CTAS_HEARTBEAT_INTERVAL</key>
        <string>900</string>
        <key>CTAS_SITE</key>
        <string>REPLACE_WITH_HOME/Library/Application Support/CTASPublisher/site</string>
        <key>CTAS_DB</key>
        <string>REPLACE_WITH_HOME/.codex/.chatgpt-projects/g-p-6a5d91be2e688191b7333527fcd488b3/data/soc.db</string>
    </dict>

    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
